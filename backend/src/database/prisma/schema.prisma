// Vahanvati Gruh Udhyog - Database Schema
// Stage: Step 1 & 2 - Core Schema & Migrations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  OUTLET
  PRODUCTION
}

enum CustomerType {
  INDIAN
  NRI
}

enum MovementType {
  SALE_OUT
  SALES_RETURN_IN
  PRODUCTION_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum ReferenceType {
  SALE
  SALES_RETURN
  PRODUCTION
  MANUAL
}

enum PaymentMode {
  CASH
  UPI
  CARD
  OTHER
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum ProductionStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum ReturnStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum RefundPaymentMode {
  CASH
  UPI
  STORE_CREDIT
}

enum RestockCondition {
  RESTOCKABLE
  DAMAGED_DISCARD
}

// ==========================================
// 1. AUTHENTICATION & USERS
// ==========================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique @db.VarChar(50)
  email        String?   @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(100)
  role         Role      @default(OUTLET)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  refreshTokens     RefreshToken[]
  sales             Sale[]
  salesReturns      SalesReturn[]
  productionEntries ProductionEntry[]
  stockMovements    StockMovement[]
  auditLogs         AuditLog[]
  payments          Payment[]
  pricesCreated     ProductPrice[]    @relation("PricesCreated")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ==========================================
// 2. CUSTOMERS
// ==========================================

model Customer {
  id           String       @id @default(uuid()) @db.Uuid
  customerType CustomerType @default(INDIAN) @map("customer_type")
  name         String       @db.VarChar(100)
  mobile       String?      @db.VarChar(20)
  email        String?      @db.VarChar(100)
  address      String?      @db.Text
  city         String?      @db.VarChar(50)
  country      String       @default("India") @db.VarChar(50)
  notes        String?      @db.Text
  gstin        String?      @db.VarChar(50)
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  sales        Sale[]
  salesReturns SalesReturn[]

  @@index([mobile])
  @@index([name])
  @@map("customers")
}

// ==========================================
// 3. PRODUCT HIERARCHY & UNITS
// ==========================================

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  code         String   @unique @db.VarChar(50)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  subcategories Subcategory[]

  @@map("categories")
}

model Subcategory {
  id           String   @id @default(uuid()) @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  name         String   @db.VarChar(100)
  code         String   @unique @db.VarChar(50)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products Product[]

  @@map("subcategories")
}

model Unit {
  id                     String   @id @default(uuid()) @db.Uuid
  name                   String   @db.VarChar(50)
  symbol                 String   @db.VarChar(10)
  isWeightBased          Boolean  @default(true) @map("is_weight_based")
  conversionFactorToBase Decimal  @default(1.0000) @map("conversion_factor_to_base") @db.Decimal(10, 4)
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  products                 Product[]
  productPackConfigurations ProductPackConfiguration[]
  productionEntries        ProductionEntry[]

  @@map("units")
}

model Product {
  id                   String   @id @default(uuid()) @db.Uuid
  subcategoryId        String   @map("subcategory_id") @db.Uuid
  primaryUnitId        String   @map("primary_unit_id") @db.Uuid
  name                 String   @db.VarChar(150)
  gujaratiName         String?  @map("gujarati_name") @db.VarChar(150)
  code                 String   @unique @db.VarChar(50)
  barcode              String?  @db.VarChar(100)
  description          String?  @db.Text
  imageUrl             String?  @map("image_url") @db.VarChar(255)
  isLooseWeightAllowed Boolean  @default(true) @map("is_loose_weight_allowed")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  subcategory        Subcategory                @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  primaryUnit        Unit                       @relation(fields: [primaryUnitId], references: [id], onDelete: Restrict)
  packConfigurations ProductPackConfiguration[]
  prices             ProductPrice[]
  stock              Stock?
  stockMovements     StockMovement[]
  saleItems          SaleItem[]
  salesReturnItems   SalesReturnItem[]
  productionEntries  ProductionEntry[]

  @@index([barcode])
  @@index([subcategoryId])
  @@index([name])
  @@map("products")
}

model ProductPackConfiguration {
  id                 String   @id @default(uuid()) @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  packName           String   @map("pack_name") @db.VarChar(50)
  weightInBaseUnits  Decimal  @map("weight_in_base_units") @db.Decimal(10, 3)
  unitId             String   @map("unit_id") @db.Uuid
  displayOrder       Int      @default(0) @map("display_order")
  isActive           Boolean  @default(true) @map("is_active")

  // Relations
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit      Unit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  prices    ProductPrice[]
  saleItems SaleItem[]

  @@map("product_pack_configurations")
}

model ProductPrice {
  id            String       @id @default(uuid()) @db.Uuid
  productId     String       @map("product_id") @db.Uuid
  packConfigId  String?      @map("pack_config_id") @db.Uuid
  customerType  CustomerType @default(INDIAN) @map("customer_type")
  rate          Decimal      @db.Decimal(12, 2)
  effectiveFrom DateTime     @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime?    @map("effective_to") @db.Timestamptz(6)
  isActive      Boolean      @default(true) @map("is_active")
  createdById   String?      @map("created_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  product    Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  packConfig ProductPackConfiguration? @relation(fields: [packConfigId], references: [id], onDelete: Cascade)
  createdBy  User?                     @relation("PricesCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId, customerType, effectiveFrom])
  @@index([productId, packConfigId])
  @@map("product_prices")
}

// ==========================================
// 4. INVENTORY & STOCK LEDGER
// ==========================================

model Stock {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @unique @map("product_id") @db.Uuid
  currentBalance   Decimal  @default(0.000) @map("current_balance") @db.Decimal(12, 3)
  minimumThreshold Decimal  @default(0.000) @map("minimum_threshold") @db.Decimal(12, 3)
  lastUpdatedAt    DateTime @default(now()) @updatedAt @map("last_updated_at") @db.Timestamptz(6)

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("stocks")
}

model StockMovement {
  id            String        @id @default(uuid()) @db.Uuid
  productId     String        @map("product_id") @db.Uuid
  movementType  MovementType  @map("movement_type")
  referenceType ReferenceType @map("reference_type")
  referenceId   String        @map("reference_id") @db.Uuid
  quantityDelta Decimal       @map("quantity_delta") @db.Decimal(12, 3)
  balanceAfter  Decimal       @map("balance_after") @db.Decimal(12, 3)
  notes         String?       @db.VarChar(255)
  createdBy     String?       @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  user    User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([referenceId])
  @@map("stock_movements")
}

// ==========================================
// 5. SALES & BILLING
// ==========================================

model Sale {
  id                     String        @id @default(uuid()) @db.Uuid
  billNumber             String        @unique @map("bill_number") @db.VarChar(50)
  customerId             String        @map("customer_id") @db.Uuid
  customerNameSnapshot   String        @map("customer_name_snapshot") @db.VarChar(100)
  customerMobileSnapshot String?       @map("customer_mobile_snapshot") @db.VarChar(20)
  customerTypeSnapshot   CustomerType  @map("customer_type_snapshot")
  totalItemsCount        Int           @map("total_items_count")
  subtotalAmount         Decimal       @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount         Decimal       @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount              Decimal       @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  finalTotalAmount       Decimal       @map("final_total_amount") @db.Decimal(12, 2)
  paidAmount             Decimal       @map("paid_amount") @db.Decimal(12, 2)
  changeReturned         Decimal       @default(0.00) @map("change_returned") @db.Decimal(12, 2)
  paymentStatus          PaymentStatus @default(PAID) @map("payment_status")
  saleStatus             SaleStatus    @default(COMPLETED) @map("sale_status")
  cancellationReason     String?       @map("cancellation_reason") @db.VarChar(255)
  createdBy              String        @map("created_by") @db.Uuid
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  user         User          @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  items        SaleItem[]
  payments     Payment[]
  salesReturns SalesReturn[]

  @@index([billNumber])
  @@index([createdAt])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id                    String   @id @default(uuid()) @db.Uuid
  saleId                String   @map("sale_id") @db.Uuid
  productId             String   @map("product_id") @db.Uuid
  packConfigId          String?  @map("pack_config_id") @db.Uuid
  productNameSnapshot   String   @map("product_name_snapshot") @db.VarChar(150)
  unitSymbolSnapshot    String   @map("unit_symbol_snapshot") @db.VarChar(20)
  weightOrPackSnapshot  String   @map("weight_or_pack_snapshot") @db.VarChar(50)
  quantity              Decimal  @db.Decimal(10, 3)
  baseWeightDeducted    Decimal  @map("base_weight_deducted") @db.Decimal(10, 3)
  unitRate              Decimal  @map("unit_rate") @db.Decimal(12, 2)
  subtotal              Decimal  @db.Decimal(12, 2)
  discount              Decimal  @default(0.00) @db.Decimal(12, 2)
  total                 Decimal  @db.Decimal(12, 2)
  returnedQuantity      Decimal  @default(0.000) @map("returned_quantity") @db.Decimal(10, 3)

  // Relations
  sale             Sale                      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product          Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  packConfig       ProductPackConfiguration? @relation(fields: [packConfigId], references: [id], onDelete: SetNull)
  salesReturnItems SalesReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id                   String      @id @default(uuid()) @db.Uuid
  saleId               String      @map("sale_id") @db.Uuid
  paymentMode          PaymentMode @map("payment_mode")
  amount               Decimal     @db.Decimal(12, 2)
  transactionReference String?     @map("transaction_reference") @db.VarChar(100)
  notes                String?     @db.VarChar(255)
  createdBy            String?     @map("created_by") @db.Uuid
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  sale Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@map("payments")
}

// ==========================================
// 6. SALES RETURNS
// ==========================================

model SalesReturn {
  id                 String            @id @default(uuid()) @db.Uuid
  returnNumber       String            @unique @map("return_number") @db.VarChar(50)
  originalSaleId     String            @map("original_sale_id") @db.Uuid
  customerId         String            @map("customer_id") @db.Uuid
  totalReturnAmount  Decimal           @map("total_return_amount") @db.Decimal(12, 2)
  refundPaymentMode  RefundPaymentMode @default(CASH) @map("refund_payment_mode")
  status             ReturnStatus      @default(COMPLETED) @map("status")
  reason             String            @db.VarChar(255)
  cancellationReason String?           @map("cancellation_reason") @db.VarChar(255)
  createdBy          String            @map("created_by") @db.Uuid
  completedAt        DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  originalSale Sale              @relation(fields: [originalSaleId], references: [id], onDelete: Restrict)
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  user         User              @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  items        SalesReturnItem[]

  @@index([returnNumber])
  @@index([originalSaleId])
  @@index([status])
  @@index([customerId])
  @@index([createdAt])
  @@map("sales_returns")
}

model SalesReturnItem {
  id                String           @id @default(uuid()) @db.Uuid
  returnId          String           @map("return_id") @db.Uuid
  saleItemId        String           @map("sale_item_id") @db.Uuid
  productId         String           @map("product_id") @db.Uuid
  returnedQuantity  Decimal          @map("returned_quantity") @db.Decimal(10, 3)
  unitRateSnapshot  Decimal          @map("unit_rate_snapshot") @db.Decimal(12, 2)
  refundAmount      Decimal          @map("refund_amount") @db.Decimal(12, 2)
  restockCondition  RestockCondition @default(RESTOCKABLE) @map("restock_condition")

  // Relations
  salesReturn SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem    SaleItem    @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([saleItemId])
  @@map("sales_return_items")
}

// ==========================================
// 7. PRODUCTION
// ==========================================

model ProductionEntry {
  id               String           @id @default(uuid()) @db.Uuid
  productionNumber String           @unique @map("production_number") @db.VarChar(50)
  batchNumber      String?          @map("batch_number") @db.VarChar(50)
  productId        String           @map("product_id") @db.Uuid
  quantityProduced Decimal          @map("quantity_produced") @db.Decimal(10, 3)
  unitId           String           @map("unit_id") @db.Uuid
  baseWeightAdded  Decimal          @map("base_weight_added") @db.Decimal(10, 3)
  status           ProductionStatus @default(COMPLETED) @map("status")
  productionDate   DateTime         @map("production_date") @db.Date
  expiryDate       DateTime?        @map("expiry_date") @db.Date
  completedAt      DateTime?        @map("completed_at") @db.Timestamptz(6)
  notes            String?          @db.Text
  createdBy        String           @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit    Unit    @relation(fields: [unitId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([productionDate])
  @@index([batchNumber])
  @@index([status])
  @@index([productId, productionDate])
  @@map("production_entries")
}

// ==========================================
// 8. AUDIT LOGGING & SETTINGS
// ==========================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  userRole   String   @map("user_role") @db.VarChar(20)
  action     String   @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.VarChar(100)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model CompanySettings {
  id                 String   @id @default(uuid()) @db.Uuid
  companyName        String   @default("Vahanvati Gruh Udhyog") @map("company_name") @db.VarChar(150)
  tagline            String?  @db.VarChar(200)
  address            String   @db.Text
  phone              String   @db.VarChar(50)
  gstin              String?  @db.VarChar(50)
  fssaiLicense       String?  @map("fssai_license") @db.VarChar(50)
  invoicePrefix      String   @default("VGU") @map("invoice_prefix") @db.VarChar(20)
  invoiceFooterNotes String?  @map("invoice_footer_notes") @db.Text
  printFormat        String   @default("THERMAL_3INCH") @map("print_format") @db.VarChar(20)
  allowNegativeStock Boolean  @default(false) @map("allow_negative_stock")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("company_settings")
}
