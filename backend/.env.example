# Vahanvati Gruh Udhyog - Backend Environment Variables

# Application
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vahanvati_db?schema=public"

# Authentication & Security
JWT_ACCESS_SECRET=vahanvati_super_secret_access_jwt_key_2026_change_in_prod
JWT_REFRESH_SECRET=vahanvati_super_secret_refresh_jwt_key_2026_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Business Settings Defaults
INVOICE_PREFIX=VGU
DEFAULT_CUSTOMER_TYPE=INDIAN
ALLOW_NEGATIVE_STOCK=false
